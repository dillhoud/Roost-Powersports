# SQLite database location. Use an ABSOLUTE path — Prisma's CLI resolves
# relative paths relative to prisma/schema.prisma, while the running app
# resolves them relative to its working directory, so a relative path here
# points the two at different files. Replace with the real absolute path to
# this project's data/ directory (Docker sets this for you already).
DATABASE_URL="file:/absolute/path/to/Book-app/data/app.db"
